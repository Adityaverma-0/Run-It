DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require&channel_binding=require
# Your real owner email. Used only for initial setup and owner recovery.
OWNER_EMAIL=
# Generate a random secret: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Keep it private. It can also reset the owner account.
OWNER_SETUP_TOKEN=
# Optional custom-domain origin, e.g. https://stock.example.com (no path).
# Render's default domain uses RENDER_EXTERNAL_URL automatically.
# APP_URL=
